# =============================================================================
# General
# =============================================================================

# Runtime environment.
# Common values: development, staging, production
ENVIRONMENT=development

# Application log level.
# Common values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# =============================================================================
# NetBox
# =============================================================================

# Base URL of the NetBox instance used by BNC.
NETBOX_URL=https://netbox.example.com

# NetBox API token used by BNC.
# The token must have the permissions required for the operations BNC performs.
NETBOX_TOKEN=changeme

# Verify the TLS certificate presented by NetBox.
# Set to "false" only when using a NetBox instance with a self-signed or
# otherwise untrusted certificate.
NETBOX_VERIFY_SSL=true


# -----------------------------------------------------------------------------
# BNC scope
# -----------------------------------------------------------------------------

# Only NetBox objects carrying this tag are exposed to BNC.
#
# This allows the NetBox instance to contain objects that are completely
# unrelated to BNC while BNC only sees the resources explicitly assigned to it.
#
# The value is the NetBox tag SLUG, not the displayed tag name.
#
# Example:
#   NetBox tag name: "external-ctrl: bnc"
#   NetBox tag slug: "external-ctrl-bnc"
#
NETBOX_TAG_EXTERNAL_CTRL=external-ctrl-bnc


# -----------------------------------------------------------------------------
# BNC management
# -----------------------------------------------------------------------------

# Objects that BNC is allowed to actively modify must additionally carry
# this tag.
#
# A resource must therefore have BOTH:
#
#   1. NETBOX_TAG_EXTERNAL_CTRL
#   2. NETBOX_TAG_STATE_MANAGE
#
# before BNC is allowed to perform management/write operations on it.
#
# The value is the NetBox tag SLUG, not the displayed tag name.
#
# Example:
#   NetBox tag name: "bnc-state: manage"
#   NetBox tag slug: "bnc-state-manage"
#
NETBOX_TAG_STATE_MANAGE=bnc-state-manage
