# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# NetBox
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=changeme
NETBOX_VERIFY_SSL=true
# Slug of the NetBox tag BNC is scoped to (e.g. tag named "external-ctrl: bnc")
NETBOX_TAG_EXTERNAL_CTRL=external-ctrl-bnc
# Slug of the NetBox tag marking devices BNC may actively manage/push config to
# (e.g. tag named "bnc-state: manage")
NETBOX_TAG_STATE_MANAGE=bnc-state-manage
